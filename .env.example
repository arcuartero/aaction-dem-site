# Copiez ce fichier en .env (jamais publié) puis complétez.
# Client OAuth Google Cloud (type « Application de bureau »)
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
# Obtenu avec : npm run reviews:auth
GBP_REFRESH_TOKEN=
# Obtenu avec : npm run reviews:list  (format : fiche=agence, séparées par des virgules)
GBP_LOCATIONS=accounts/000/locations/111=knutange,accounts/000/locations/222=metz
